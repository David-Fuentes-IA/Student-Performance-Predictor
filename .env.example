# Copia este archivo como ".env" y rellena los valores. ".env" NO se sube a GitHub.
# En Vercel: Project Settings -> Environment Variables (mismos nombres).

# Cadena de conexion de MongoDB Atlas (Connect -> Drivers)
MONGODB_URI=mongodb+srv://USUARIO:PASSWORD@TU-CLUSTER.mongodb.net/?appName=NombreApp

# Nombre de la base de datos (opcional, por defecto: student_predictor)
MONGODB_DB=student_predictor

# Opcional: si se define, la interfaz web pedira esta contrasena
ADMIN_PASSWORD=

# Opcional: umbral (0-100) a partir del cual un alumno es "Alto riesgo" y se dispara la alerta
# en el log (por defecto 75). Se lee al arrancar: hay que reiniciar el servidor para cambiarlo.
RISK_THRESHOLD=75

# Opcional: carpeta del modelo entrenado (por defecto ./models)
MODEL_DIR=

# Opcional: modelo a entrenar (random_forest | logistic_regression). Por defecto el validado
# en docs/evidence/model/ (logistic_regression). Solo afecta a scripts/train_model.py.
RISK_MODEL=

# --- Docker (docker-compose.yml) ---
# Con Docker, la aplicacion usa un MongoDB propio del compose. Para usar Atlas en su lugar, define
# DOCKER_MONGODB_URI (es una variable distinta de MONGODB_URI porque "localhost" dentro de un
# contenedor seria el propio contenedor).
DOCKER_MONGODB_URI=
# Puerto publicado en tu maquina (por defecto 8000) y datos de demostracion al arrancar (true/false).
APP_PORT=8000
SEED_DEMO=true

# Solo desarrollo: si MONGODB_URI esta definido pero la base no responde al arrancar, la aplicacion se
# detiene (asi un despliegue nunca sirve alumnos ficticios sin avisar). Con "true" arranca con datos demo.
ALLOW_DEMO_FALLBACK=false
