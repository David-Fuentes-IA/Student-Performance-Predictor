# Copy this file to ".env" (it is ignored by git) and change only what you need.
# Every value is read at start-up: restart the application after editing.
# On Vercel, use Project Settings -> Environment Variables with the same names.

# --- Database ------------------------------------------------------------------------------------
# Empty = demo mode: three in-memory demo groups, administration panel disabled.
# Local MongoDB in Docker:  MONGODB_URI=mongodb://localhost:27018
# MongoDB Atlas:            MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR-CLUSTER.mongodb.net/?appName=YourApp
MONGODB_URI=
MONGODB_DB=student_predictor

# If MONGODB_URI is set but the database does not answer at start-up, the application stops with a
# clear message instead of silently serving fake students. "true" allows demo data instead (development only).
ALLOW_DEMO_FALLBACK=false

# --- Security ------------------------------------------------------------------------------------
# If set, the administration panel (/admin) asks for this password. Set it whenever other machines can
# reach the application.
ADMIN_PASSWORD=

# --- Risk levels ---------------------------------------------------------------------------------
# "Alto riesgo" (and the alert) = average grade below PASSING_GRADE (60 = 6.0, a failing average)
# OR the model's risk score at or above RISK_THRESHOLD. Both are numbers from 0 to 100.
PASSING_GRADE=60
RISK_THRESHOLD=75

# --- Model ---------------------------------------------------------------------------------------
# Model trained by scripts/train_model.py: random_forest | logistic_regression. Empty = the validated
# one (logistic_regression, see docs/evidence/model/README.md).
RISK_MODEL=
# Folder with risk_model.joblib and model_card.json. Empty = ./models
MODEL_DIR=

# --- Docker only (docker-compose.yml) ------------------------------------------------------------
# The compose file starts its own MongoDB. To use Atlas instead, set DOCKER_MONGODB_URI (a separate
# variable because "localhost" inside a container is the container itself).
DOCKER_MONGODB_URI=
APP_PORT=8000
SEED_DEMO=true
